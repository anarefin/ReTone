<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The bundled llama-server (hardened runtime) loads llama.cpp's dylibs
         from next to itself (@loader_path). They are signed ad-hoc, i.e. with
         no Team ID, which library validation would refuse. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
